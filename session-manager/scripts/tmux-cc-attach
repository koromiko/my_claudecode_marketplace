#!/usr/bin/env bash
#
# tmux-cc-attach — launches the sessions web UI, and serves as its
# machine-readable backend.
#
# With no --json flag (the default), execs the web server (tmux-cc-web.py),
# which lists live tmux sessions and resumable ended sessions grouped by
# project, in the browser.
#
# --json prints resumable/live sessions as a JSON array and exits; it is the
# backend tmux-cc-web.py (and other tooling) consumes, not a UI of its own.
#
# A session's project is the parent of its `git rev-parse --git-common-dir`,
# which maps git worktrees back onto their main repo.

set -uo pipefail

readonly RESUME_MAX_AGE_DAYS_DEFAULT=14
RESUME_MAX_AGE_DAYS="${RESUME_MAX_AGE_DAYS:-$RESUME_MAX_AGE_DAYS_DEFAULT}"
SM_HOME="${CLAUDE_SM_HOME:-$HOME/.claude/session-manager}"
PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

DRY_RUN=0
RESUME=1
RESUME_ONLY=0
JSON_MODE=0
PROJECT_GLOBS=()

usage() {
    cat <<'EOF'
Usage: tmux-cc-attach [options]

With no options (other than the web-launch ones below), execs the sessions
web UI (tmux-cc-web.py), which lists live and resumable sessions grouped by
project in the browser.

Options:
  --port PORT             Web server port (passed through to tmux-cc-web.py)
  --host HOST             Web server bind host (passed through)
  --no-open               Don't auto-open a browser tab (passed through)
      --json              Print resumable/live sessions as JSON and exit
                          (the machine-readable backend; no web server)
  -p, --project GLOB      (--json only) restrict to project paths matching
                          GLOB (repeatable)
      --since DAYS        (--json only) recency window override (default 14)
  -h, --help              This message
EOF
}

die() {
    printf 'tmux-cc-attach: %s\n' "$1" >&2
    exit 1
}

# --- project resolution -------------------------------------------------------

# Parent of the main worktree's git dir, so worktrees collapse onto their repo.
project_of_dir() {
    local dir="$1" common
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
        printf '%s\n' "(unknown)"
        return
    fi
    if common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
        && [ -n "$common" ]; then
        dirname "$common"
    else
        printf '%s\n' "$dir"
    fi
}

matches_any() {
    local value="$1"; shift
    local glob
    for glob in "$@"; do
        # shellcheck disable=SC2053
        [[ $value == $glob ]] && return 0
    done
    return 1
}

# --- AppleScript helpers ------------------------------------------------------

escape_applescript() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# The command reaches the shell inside single quotes; close/reopen to embed one.
escape_shell_single() {
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
}

# --- resume store ------------------------------------------------------------

resume_dir()      { printf '%s\n' "$SM_HOME/resume"; }
transcript_root() { printf '%s\n' "$PROJECTS_DIR"; }

# 0 if ts_end is within max_age_days of now.
resume_within_age() {
    local te="$1" now="$2" days="$3"
    case "$te" in ''|*[!0-9]*) return 1 ;; esac
    [ "$te" -ge "$(( now - days * 86400 ))" ]
}

# 0 if a transcript exists for this session id under the transcript root.
resume_is_resumable() {
    local id="$1" root="$2"
    compgen -G "$root/*/$id.jsonl" >/dev/null 2>&1
}

# 0 if the session's transcript marks it as an autonomous teammate/agent
# session (carries a "type":"agent-setting" record); human sessions have none.
resume_is_autonomous() {
    local id="$1" root="$2" f
    for f in "$root"/*/"$id".jsonl; do
        [ -e "$f" ] || continue
        grep -q '"type":"agent-setting"' "$f" && return 0
    done
    return 1
}

# Emit one line per resume record: id|cwd|ts_end|reason
read_resume_records() {
    local d f
    d=$(resume_dir)
    for f in "$d"/*.json; do
        [ -e "$f" ] || continue
        jq -r '[.session_id, .cwd, (.ts_end|tostring), (.reason // "")] | join("|")' \
            "$f" 2>/dev/null
    done
}

LOCATOR="${TMUX_CC_LOCATOR:-$(cd "$(dirname "$0")" && pwd)/locator.py}"

# Raw `locator.py list` output (JSON array). Empty on any failure. Captured
# once per run so the live scan (the slow path) is never repeated.
LOCATOR_JSON=""
run_locator_list() {
    command -v python3 >/dev/null 2>&1 || return 0
    [ -f "$LOCATOR" ] || return 0
    python3 "$LOCATOR" list 2>/dev/null
}

# session_ids currently live per the captured locator output.
live_session_ids() {
    printf '%s' "$LOCATOR_JSON" | jq -r '.[].session_id' 2>/dev/null
}

# One compact JSON object per interactive live session, tagged status:"live",
# honoring the same --project filter as the resumable list. A live process with
# no transcript on disk (e.g. a `claude -r` picker that never started a session)
# has nothing to resume or fork, so it is omitted.
live_sessions_json() {
    local sid cwd proj root
    root=$(transcript_root)
    while IFS='|' read -r sid cwd pid pane host tty tsession; do
        [ -n "$sid" ] || continue
        resume_is_resumable "$sid" "$root" || continue
        proj=$(project_of_dir "$cwd")
        if [ ${#PROJECT_GLOBS[@]} -gt 0 ] && ! matches_any "$proj" "${PROJECT_GLOBS[@]}"; then
            continue
        fi
        jq -cn --arg id "$sid" --arg cwd "$cwd" --arg project "$proj" \
            --arg pid "$pid" --arg pane "$pane" --arg host "$host" \
            --arg tty "$tty" --arg tmux_session "$tsession" \
            '{session_id:$id, cwd:$cwd, project:$project, pid:$pid, pane:$pane, host:$host, tty:$tty, tmux_session:$tmux_session, status:"live"}'
    done < <(printf '%s' "$LOCATOR_JSON" \
        | jq -r '.[] | select(.role=="interactive")
                 | [.session_id, (.cwd // ""), ((.leader_pid // "")|tostring),
                    (.pane // ""), (.host // ""), (.tty // ""),
                    (.tmux.session // "")] | join("|")' 2>/dev/null)
}

# When sourced by tests, stop here with all helpers defined.
if [ -n "${TMUX_CC_LIB_ONLY:-}" ]; then
    return 0 2>/dev/null || exit 0
fi

# --- argument parsing ---------------------------------------------------------

JSON_MODE=0
WEB_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --json)         JSON_MODE=1; RESUME_ONLY=1; RESUME=1; shift ;;
        -p|--project)   [ $# -ge 2 ] || die "--project needs a glob"; PROJECT_GLOBS+=("$2"); shift 2 ;;
        --since)        [ $# -ge 2 ] || die "--since needs days"; case "$2" in ''|*[!0-9]*) die "--since needs a non-negative integer" ;; esac; RESUME_MAX_AGE_DAYS="$2"; shift 2 ;;
        --port|--host)  WEB_ARGS+=("$1" "$2"); shift 2 ;;
        --no-open)      WEB_ARGS+=("$1"); shift ;;
        -h|--help)      usage; exit 0 ;;
        *)              die "unknown option: $1 (try --help)" ;;
    esac
done

if [ "$JSON_MODE" -eq 0 ]; then
    # Resolve through symlinks (README installs this via ~/.local/bin symlink).
    _src="$0"
    while [ -L "$_src" ]; do
        _dir="$(cd -P "$(dirname "$_src")" && pwd)"
        _src="$(readlink "$_src")"
        case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
    done
    _selfdir="$(cd -P "$(dirname "$_src")" && pwd)"
    exec python3 "$_selfdir/tmux-cc-web.py" ${WEB_ARGS[@]+"${WEB_ARGS[@]}"}
fi
command -v jq >/dev/null 2>&1 || die "jq required for --json"

# --- resume work list --------------------------------------------------------

RESUME_IDS=()
RESUME_CWDS=()
RESUME_PROJECT=()
RESUME_REASON=()
RESUME_TS=()

if [ "$RESUME" -eq 1 ]; then
    now=$(date +%s)
    # Stale/dead records are pruned only when actually resuming. --json (the
    # read-only web view) must never delete records — otherwise a narrower
    # --since window would permanently drop resumable sessions.
    PRUNE_STALE=1
    { [ "$DRY_RUN" -eq 1 ] || [ "$JSON_MODE" -eq 1 ]; } && PRUNE_STALE=0
    LOCATOR_JSON=$(run_locator_list)
    live_ids=$(live_session_ids)
    troot=$(transcript_root)
    while IFS='|' read -r rid rcwd rts rreason; do
        [ -n "$rid" ] || continue
        resume_within_age "$rts" "$now" "$RESUME_MAX_AGE_DAYS" || { [ "$PRUNE_STALE" -eq 1 ] && rm -f "$(resume_dir)/$rid.json" 2>/dev/null; continue; }
        resume_is_resumable "$rid" "$troot" || { [ "$PRUNE_STALE" -eq 1 ] && rm -f "$(resume_dir)/$rid.json" 2>/dev/null; continue; }
        resume_is_autonomous "$rid" "$troot" && continue
        printf '%s\n' "$live_ids" | grep -qx "$rid" && continue
        proj=$(project_of_dir "$rcwd")
        if [ ${#PROJECT_GLOBS[@]} -gt 0 ] && ! matches_any "$proj" "${PROJECT_GLOBS[@]}"; then
            continue
        fi
        RESUME_IDS+=("$rid")
        RESUME_CWDS+=("$rcwd")
        RESUME_PROJECT+=("$proj")
        RESUME_REASON+=("$rreason")
        RESUME_TS+=("$rts")
    done < <(read_resume_records)
fi

if [ "$JSON_MODE" -eq 1 ]; then
    {
        if [ ${#RESUME_IDS[@]} -gt 0 ]; then
            for i in "${!RESUME_IDS[@]}"; do
                jq -cn \
                    --arg id "${RESUME_IDS[i]}" \
                    --arg cwd "${RESUME_CWDS[i]}" \
                    --arg project "${RESUME_PROJECT[i]}" \
                    --argjson ts_end "${RESUME_TS[i]}" \
                    --arg reason "${RESUME_REASON[i]}" \
                    '{session_id:$id, cwd:$cwd, project:$project, ts_end:$ts_end, reason:$reason, status:"ended"}'
            done
        fi
        live_sessions_json
    } | jq -sc '.'
    exit 0
fi
